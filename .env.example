# Copy to .env and adjust if you want non-default values.
# docker-compose up works with none of this set - these are the defaults.

DB_NAME=internship_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Must be at least 32 bytes for HS256. Generate one with: openssl rand -base64 32
JWT_SECRET=local-dev-only-secret-please-change-32bytes
JWT_EXPIRATION_MS=86400000
