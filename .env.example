# Copy to .env and adjust if you want non-default values.
# docker-compose up works with none of this set - these are the defaults.

DB_NAME=internship_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Must be at least 32 bytes for HS256. Generate one with: openssl rand -base64 32
JWT_SECRET=local-dev-only-secret-please-change-32bytes
JWT_EXPIRATION_MS=86400000

# --- Job alerts (optional) ---
# Without these, saved searches can be created but the poller finds nothing and
# emails never send - it fails silently (logged, not crashing the app).

# SMTP account to send job alert emails from. Example: a Gmail address with an
# app password (not your regular password) - https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@internship-tracker.local

# Local email testing: the bundled Mailpit container catches all mail instead of
# sending it. Uncomment these, then view emails at http://localhost:8025
# MAIL_HOST=mailpit
# MAIL_PORT=1025

# Free API credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# How often (ms) to poll saved searches. Default: 6 hours - keep this generous,
# free-tier job search APIs have low monthly call limits.
JOB_ALERT_POLL_INTERVAL_MS=21600000
